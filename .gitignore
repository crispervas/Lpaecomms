# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------------------------------------------------------------------------
# Environment & secrets
# Commit only the example files (.env.example, .env.<environment>.example);
# never the real ones.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
dist/
build/
out/
.output/

# LESS: generated stylesheet compiled into the Express static assets.
# Keep the source LESS; ignore the compiled bundle and its source map.
cluster3-project/web/src/public/css/main.css
cluster3-project/web/src/public/css/main.css.map

# ---------------------------------------------------------------------------
# Web (Express 5 + EJS + LESS)
# ---------------------------------------------------------------------------
*.local

# ---------------------------------------------------------------------------
# Mobile (Ionic + React)
# ---------------------------------------------------------------------------
.ionic/
www/
platforms/
plugins/
# Native Capacitor projects are generated from config; regenerate with `npx cap add`.
cluster3-project/mobile/android/
cluster3-project/mobile/ios/

# ---------------------------------------------------------------------------
# Desktop (Electron)
# ---------------------------------------------------------------------------
# Packaged installers and unpacked app output.
release/
# Configuration baked into a packaged build by scripts/dist.mjs; regenerated
# on every build and specific to the machine that built it.
cluster3-project/desktop/app-config.json
app/dist/

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------------
# Testing & coverage
# ---------------------------------------------------------------------------
coverage/
.nyc_output/

# ---------------------------------------------------------------------------
# Caches
# ---------------------------------------------------------------------------
.cache/
.parcel-cache/
.vite/
.eslintcache
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Editors & OS
# ---------------------------------------------------------------------------
.DS_Store
.idea/
*.swp
*.swo
# Keep shared VS Code settings; ignore per-user state.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

CLAUDE.md
Info.md
Mockup/

# Design specs and implementation plans: working notes, not deliverables.
documentation/superpowers/
# Scratch workspace for plan execution (ledger, briefs, review packages).
.superpowers/
.claude