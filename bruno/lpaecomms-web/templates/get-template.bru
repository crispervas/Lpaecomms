meta {
  name: Get template
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/templates/1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  # Get one template

  Returns one active template by id.

  ## Auth

  Bearer token of a user whose role is `ADMIN` (send **auth/Log in** first; it stores `{{token}}`).

  ## Path parameters

  | Name | Type | Required | Notes |
  | --- | --- | --- | --- |
  | `id` | integer | yes | Positive integer. |

  ## Responses

  ### 200 OK

    {
      "message": "Template found",
      "data": {
        "id": 1,
        "name": "Order confirmation",
        "code": "ORDER_CONFIRMATION",
        "subject": "Your Lpaecomms order",
        "html": "<p>Thanks for your order!</p>",
        "description": null,
        "unixTime": 1790476214,
        "created": {
          "client": "2026-09-27T02:30:14.000Z",
          "server": "2026-09-27T02:30:14.000Z",
          "serverDate": "2026-09-27",
          "serverTime": "12:30:14",
          "unixTime": 1790476214,
          "user": 1,
          "role": "ADMIN"
        },
        "updated": null,
        "statusName": "ACTIVE",
        "status": 1,
        "createdAt": "2026-09-27T02:30:14.000Z",
        "updatedAt": "2026-09-27T02:30:14.000Z"
      },
      "pagination": null
    }

  ### 400 Bad Request — validation failed

  `id` is not a positive integer.

    {
      "message": "Some fields need attention.",
      "data": null,
      "pagination": null,
      "errors": [
        {
          "field": "id",
          "message": "Invalid input"
        }
      ]
    }

  ### 401 Unauthorized — missing, invalid or expired token

    {
      "message": "Sign in to continue.",
      "data": null,
      "pagination": null,
      "errors": []
    }

  ### 403 Forbidden — the token's role is not ADMIN

    {
      "message": "You do not have permission to do this.",
      "data": null,
      "pagination": null,
      "errors": []
    }

  ### 404 Not Found — no active template with this id

  Soft-deleted records answer 404 too.

    {
      "message": "Template not found.",
      "data": null,
      "pagination": null,
      "errors": []
    }

  Outside production, error bodies also carry `stack`.
}
