{
  "name": "lpaecomms-desktop",
  "version": "0.1.0",
  "description": "Electron desktop admin client for the Lpaecomms store",
  "private": true,
  "license": "UNLICENSED",
  "author": "Cristhian Pereira",
  "type": "commonjs",
  "main": "src/main/index.js",
  "engines": { "node": ">=20" },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:renderer\" \"pnpm dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "wait-on tcp:5173 && electron .",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "electron": "^40.0.0",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^3.4.19",
    "vite": "^7.1.0",
    "wait-on": "^9.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "esbuild"]
  }
}
