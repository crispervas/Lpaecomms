# Example production configuration for the desktop platform.
#
# Copy this file to `.env.production`. Then:
#   NODE_ENV=production pnpm start      # run the admin against the live API
#   NODE_ENV=production pnpm dist:mac   # bake it into a production installer
# Never commit the real file.

# --- Application ---------------------------------------------------------
NODE_ENV=production

# --- REST API ------------------------------------------------------------
# The deployed web service, including the /api/v1 prefix, e.g. the Render URL:
# https://<your-service>.onrender.com/api/v1
API_BASE_URL=

# A free Render service sleeps when idle and needs up to a minute to wake, so
# allow longer than in development. Optional: defaults to 5000.
API_TIMEOUT_MS=30000

# --- Development ---------------------------------------------------------
# Only used when the renderer is served by Vite (pnpm dev). `pnpm start` and
# installers load the compiled renderer instead.
DEV_SERVER_URL=http://localhost:5173
USE_BUILT_RENDERER=false
