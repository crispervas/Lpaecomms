# Example staging configuration for the desktop platform.
#
# Copy this file to `.env.staging` and run with NODE_ENV=staging, e.g.
#   NODE_ENV=staging pnpm start
#   NODE_ENV=staging pnpm dist:mac
# Never commit the real file.

# --- Application ---------------------------------------------------------
NODE_ENV=staging

# --- REST API ------------------------------------------------------------
# The staging web service, including the /api/v1 prefix.
API_BASE_URL=

# Optional: defaults to 5000.
API_TIMEOUT_MS=30000

# --- Development ---------------------------------------------------------
DEV_SERVER_URL=http://localhost:5173
USE_BUILT_RENDERER=false
