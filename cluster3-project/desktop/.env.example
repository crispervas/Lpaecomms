# Example environment configuration for the desktop platform.
# Copy this file to `.env` and adjust the values for your machine.
# Never commit the real `.env` file.

# --- Application ---------------------------------------------------------
# Active environment: development | staging | production
# This decides WHICH API the app talks to. It does not decide how the renderer
# is served — that follows from whether the app is packaged.
NODE_ENV=development

# --- REST API ------------------------------------------------------------
# Base URL of the Lpaecomms REST API, including the /api/v1 prefix.
# development: http://localhost:3000/api/v1
# staging:     https://staging.lpaecomms.example/api/v1
# production:  https://lpaecomms.example/api/v1
API_BASE_URL=http://localhost:3000/api/v1

# How long to wait for an API response before giving up, in milliseconds.
# Optional: defaults to 5000.
API_TIMEOUT_MS=5000

# --- Development ---------------------------------------------------------
# Vite dev server the window loads when the app is not packaged. Must match the
# port pinned in vite.config.mjs. Ignored in a packaged build.
DEV_SERVER_URL=http://localhost:5173
