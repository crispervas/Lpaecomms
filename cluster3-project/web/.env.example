# Example environment configuration for the web platform.
# Copy this file to `.env` and adjust the values for your machine.
# Never commit the real `.env` file.

# --- Application ---------------------------------------------------------
# Active environment: development | staging | production
NODE_ENV=development
# HTTP port the Express server listens on.
PORT=3000

# --- PostgreSQL (consumed by docker-compose.yml) -------------------------
POSTGRES_USER=lpaecomms
POSTGRES_PASSWORD=lpaecomms_dev_password
POSTGRES_DB=lpaecommsdb
# Host the app connects to. Use localhost when the container maps a host port.
POSTGRES_HOST=localhost
# Host port mapped to the container; change it if 5432 is already in use.
POSTGRES_PORT=5432

# --- Database connection (consumed by Prisma and the app) ----------------
# Composed from the POSTGRES_* values above; dotenv-expand resolves the
# ${...} references at load time, so there is a single source of truth.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# --- External services ---------------------------------------------------
# API Ninjas key for the currency converter mashup (https://api-ninjas.com).
# Optional: without it the app still runs and only GET /api/v1/convert
# answers 503. Never expose this value to the browser.
NINJA_API_KEY=

# --- Authentication ------------------------------------------------------
# Secret that signs API access tokens. Required; at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Token lifetime, in jsonwebtoken's format (e.g. 15m, 1h, 1d).
JWT_EXPIRES_IN=1h

# --- Audit ---------------------------------------------------------------
# IANA time zone used for serverDate/serverTime in the created/updated audit blocks.
APP_TIMEZONE=Australia/Brisbane

# --- Seed (prisma/seed.js only) ------------------------------------------
# Credentials of the administrator the seed creates. Never reuse a real password.
SEED_ADMIN_EMAIL=admin@lpaecomms.test
SEED_ADMIN_PASSWORD=
