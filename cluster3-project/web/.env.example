# Example environment configuration for the web platform.
# Copy this file to `.env` and adjust the values for your machine.
# Never commit the real `.env` file.

# --- Application ---------------------------------------------------------
# Active environment: development | staging | production
NODE_ENV=development
# HTTP port the Express server listens on.
PORT=3000

# --- PostgreSQL (consumed by docker-compose.yml) -------------------------
POSTGRES_USER=lpaecomms
POSTGRES_PASSWORD=lpaecomms_dev_password
POSTGRES_DB=lpaecomms_web
# Host port mapped to the container; change it if 5432 is already in use.
POSTGRES_PORT=5432

# --- Database connection (consumed by Prisma and the app) ----------------
# Must match the POSTGRES_* values above.
DATABASE_URL="postgresql://lpaecomms:lpaecomms_dev_password@localhost:5432/lpaecomms_web?schema=public"
