<%#
  Base layout for every server-rendered page.

  Renders the HTML document shell and wraps a page template. Controllers call
  res.render('layouts/base', { title, page }): `page` is the name of a template
  in src/views/pages, which this layout includes between the shared header and
  footer partials. This keeps a single place for the document head, styles, and
  chrome without a separate layout engine.

  Two optional locals let a page pull in its own assets without a bundler:
  `styles` (array of stylesheet URLs added to <head>) and `scripts` (array of
  script URLs loaded, in order, at the end of <body>). Pages that omit them
  render unchanged.
%>
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= typeof title !== 'undefined' ? title : 'Lpaecomms' %></title>
    <%# Mockup typography. Loaded from the CDN because the project has no
        bundler: the Tailwind CLI alone cannot rewrite font asset paths. %>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/tailwind.css" />
    <%# The hand-authored stylesheet, compiled from styles/less. Loaded after
        Tailwind for the duration of the migration so a page that has been
        ported wins over the utilities it used to carry, and a page that has not
        renders exactly as before. Tailwind and this link go away together in
        the final step of the migration. %>
    <link rel="stylesheet" href="/css/main.css" />
    <%# Optional per-page stylesheets, injected through the `styles` local
        (e.g. Leaflet on the Contact page). %>
    <% (typeof styles !== 'undefined' ? styles : []).forEach((href) => { %>
    <link rel="stylesheet" href="<%= href %>" />
    <% }) %>
  </head>
  <body class="page">
    <%- include('../partials/header') %>
    <%# The optional `bleed` local drops the shared container so a page can run
        edge to edge — the login page's split screen, which the mockup draws
        filling the viewport. Every page that omits it renders in the container. %>
    <main class="page__main<%= typeof bleed !== 'undefined' && bleed ? ' page__main--bleed' : '' %>">
      <%- include('../pages/' + page) %>
    </main>
    <%- include('../partials/footer') %>
    <script src="/js/nav.js" defer></script>
    <%# Optional per-page scripts, injected through the `scripts` local and
        loaded in order after the shared ones (e.g. Leaflet, then the map init).
        `defer` preserves order and runs them once the DOM is parsed. %>
    <% (typeof scripts !== 'undefined' ? scripts : []).forEach((src) => { %>
    <script src="<%= src %>" defer></script>
    <% }) %>
  </body>
</html>
