<%#
  Base layout for every server-rendered page.

  Renders the HTML document shell and wraps a page template. Controllers call
  res.render('layouts/base', { title, page }): `page` is the name of a template
  in src/views/pages, which this layout includes between the shared header and
  footer partials. This keeps a single place for the document head, styles, and
  chrome without a separate layout engine.
%>
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= typeof title !== 'undefined' ? title : 'Lpaecomms' %></title>
    <link rel="stylesheet" href="/css/tailwind.css" />
  </head>
  <body class="flex min-h-screen flex-col bg-slate-50 text-slate-900">
    <%- include('../partials/header') %>
    <%# pt-20 clears the fixed header; flex-1 pushes the footer to the bottom. %>
    <main class="mx-auto w-full max-w-5xl flex-1 px-4 pb-10 pt-20">
      <%- include('../pages/' + page) %>
    </main>
    <%- include('../partials/footer') %>
    <script src="/js/nav.js" defer></script>
  </body>
</html>
