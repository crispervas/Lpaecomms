<%#
  Site footer shared by every page, built from the home mockup.

  Shop items and Careers/Press are plain text, exactly as in the mockup: those
  destinations do not exist. About is a real link. The newsletter has no
  backend, so it renders without a <form> and with both controls disabled —
  the UI must never imply a submission the site cannot perform.
%>
<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__columns">
      <div>
        <span class="site-footer__brand">LPA Ecomms</span>
        <p class="site-footer__blurb">
          Desk peripherals designed for daily use, sold direct.
        </p>
      </div>

      <div class="footer-column">
        <span class="footer-column__heading">Shop</span>
        <span>Keyboards</span>
        <span>Mice</span>
        <span>Headsets</span>
        <span>Monitors</span>
      </div>

      <div class="footer-column">
        <span class="footer-column__heading">Company</span>
        <a href="/about" class="footer-column__link">About</a>
        <span>Careers</span>
        <span>Press</span>
      </div>

      <div class="newsletter">
        <span class="newsletter__heading">Stay in the loop</span>
        <div class="newsletter__controls">
          <input type="email" placeholder="you@email.com" disabled title="Coming soon"
            class="newsletter__input" />
          <button type="button" disabled title="Coming soon" class="newsletter__button">
            Join
          </button>
        </div>
      </div>
    </div>

    <div class="site-footer__legal">
      <span>&copy; <%= new Date().getFullYear() %> LPA Ecomms</span>
      <span>Privacy · Terms</span>
    </div>
  </div>
</footer>
