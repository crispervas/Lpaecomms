<%#
  Site header shared by every page: brand, primary navigation, and the
  storefront controls taken from the home mockup.

  The active link is highlighted from `currentPath` (set on res.locals in
  app.js). The menu collapses into a toggle button below the `sm` breakpoint;
  the toggle is driven by /js/nav.js.

  The search field is a GET form to /catalog, so a search is a URL like any
  other catalog view; on the catalog it shows the current search (`q`, set by
  the catalog controller). The cart
  links to /cart with a badge counted from the cart cookie (`cartCount`, set
  on res.locals by config/cart.js).
%>
<%
  const navLinks = [
    { href: '/', label: 'Home' },
    { href: '/catalog', label: 'Catalog' },
    { href: '/about', label: 'About' },
    { href: '/mashup', label: 'Mashups' },
    { href: '/contact', label: 'Contact us' },
  ];
  // Login is deliberately not in navLinks: the mockup keeps the page links on
  // the left and puts the account control on the right, beside the cart. It is
  // rendered separately in both places below — the desktop cluster is
  // `sm:flex`, so the collapsed menu needs its own copy or Login disappears on
  // a phone.
  const loginHref = '/login';
  // Set by middlewares/customerSession.js; guarded like the cart below.
  const signedIn = typeof customer === 'object' && customer !== null;
  // Guarded because a render that skipped the middleware must still draw the
  // header; an empty cart is the honest default.
  const cartUnits = typeof cartCount === 'number' ? cartCount : 0;
  // Three digits would not fit the badge, so a big cart reads "99+".
  const cartBadge = cartUnits > 99 ? '99+' : String(cartUnits);
  const cartLabel = `Cart, ${cartUnits} ${cartUnits === 1 ? 'item' : 'items'}`;
  // Only the catalog passes `q`; every other page renders an empty field.
  const searchText = typeof q === 'string' ? q : '';
  // Home matches only "/"; other links match their path and anything below it.
  const isActive = (href) =>
    href === '/' ? currentPath === '/' : currentPath.startsWith(href);
%>
<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="brand">
      <span class="brand__name">LPA</span>
      <span class="brand__tag">ECOMMS</span>
    </a>

    <nav class="site-nav">
      <% navLinks.forEach((link) => { %>
        <a href="<%= link.href %>"
          class="site-nav__link<%= isActive(link.href) ? ' is-active' : '' %>">
          <%= link.label %>
        </a>
      <% }) %>
    </nav>

    <div class="site-tools">
      <form action="/catalog" method="get" role="search" class="search">
        <svg class="search__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="search" name="q" value="<%= searchText %>" maxlength="100"
          placeholder="Search peripherals..." aria-label="Search products" class="search__input" />
      </form>

      <%# The badge is counted from the cart cookie by config/cart.js. It is
          aria-hidden because the link's own label already says the number,
          and a bare "3" read after it would only repeat it without context. %>
      <a href="/cart" aria-label="<%= cartLabel %>"
        class="cart<%= isActive('/cart') ? ' is-active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 6h15l-1.5 9h-12z"></path>
          <circle cx="9" cy="20" r="1"></circle>
          <circle cx="18" cy="20" r="1"></circle>
        </svg>
        <span class="cart__count" aria-hidden="true"><%= cartBadge %></span>
      </a>

      <%# Opens the appearance panel. A real button, so it is reachable by
          keyboard; aria-expanded is kept in sync by /js/appearance.js. %>
      <button type="button" id="appearance-toggle" aria-controls="appearance-panel"
        aria-expanded="false" class="appearance-toggle">
        <span class="u-visually-hidden">Appearance settings</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor" stroke="none"></path>
        </svg>
      </button>

      <%# A visitor gets Login; a customer gets their account and a log-out
          button. Log out is a POST form, because a GET link would let any
          page sign a customer out with an image tag. %>
      <% if (signedIn) { %>
        <a href="/account"
          class="site-tools__login<%= isActive('/account') ? ' is-active' : '' %>">
          <%= customer.name %>
        </a>
        <form method="post" action="/logout" class="site-tools__logout">
          <button type="submit" class="site-tools__login">Log out</button>
        </form>
      <% } else { %>
        <a href="<%= loginHref %>"
          class="site-tools__login<%= isActive(loginHref) ? ' is-active' : '' %>">
          Login
        </a>
      <% } %>
    </div>

    <button type="button" id="nav-toggle" aria-controls="mobile-nav" aria-expanded="false"
      class="nav-toggle">
      <span class="u-visually-hidden">Toggle navigation</span>
      <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <nav id="mobile-nav" class="mobile-nav">
    <div class="mobile-nav__list">
      <%# Search again, for the same reason as Cart and Login below. %>
      <form action="/catalog" method="get" role="search" class="search search--block">
        <svg class="search__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="search" name="q" value="<%= searchText %>" maxlength="100"
          placeholder="Search peripherals..." aria-label="Search products" class="search__input" />
      </form>
      <% navLinks.forEach((link) => { %>
        <a href="<%= link.href %>"
          class="mobile-nav__link<%= isActive(link.href) ? ' is-active' : '' %>">
          <%= link.label %>
        </a>
      <% }) %>

      <%# Cart and Login again, because the cluster they joined on desktop is
          hidden here. %>
      <a href="/cart"
        class="mobile-nav__link mobile-nav__link--login<%= isActive('/cart') ? ' is-active' : '' %>">
        Cart (<%= cartUnits %>)
      </a>
      <% if (signedIn) { %>
        <a href="/account"
          class="mobile-nav__link mobile-nav__link--login<%= isActive('/account') ? ' is-active' : '' %>">
          Account (<%= customer.name %>)
        </a>
        <form method="post" action="/logout">
          <button type="submit" class="mobile-nav__link mobile-nav__link--login">Log out</button>
        </form>
      <% } else { %>
        <a href="<%= loginHref %>"
          class="mobile-nav__link mobile-nav__link--login<%= isActive(loginHref) ? ' is-active' : '' %>">
          Login
        </a>
      <% } %>
    </div>
  </nav>
</header>
