<%#
  Site header shared by every page: brand and primary navigation.

  The active link is highlighted from `currentPath` (set on res.locals in app.js).
  The menu collapses into a toggle button below the `sm` breakpoint; the toggle
  is driven by /js/nav.js.
%>
<%
  const navLinks = [
    { href: '/', label: 'Home' },
    { href: '/about', label: 'About' },
    { href: '/contact', label: 'Contact us' },
    { href: '/login', label: 'Login' },
  ];
  // Home matches only "/"; other links match their path and anything below it.
  const isActive = (href) =>
    href === '/' ? currentPath === '/' : currentPath.startsWith(href);
%>
<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4">
    <a href="/" class="text-lg font-semibold tracking-tight">Lpaecomms</a>

    <nav class="hidden gap-6 text-sm sm:flex">
      <% navLinks.forEach((link) => { %>
        <a href="<%= link.href %>"
          class="<%= isActive(link.href) ? 'font-medium text-slate-900' : 'text-slate-600 hover:text-slate-900' %>">
          <%= link.label %>
        </a>
      <% }) %>
    </nav>

    <button type="button" id="nav-toggle" aria-controls="mobile-nav" aria-expanded="false"
      class="inline-flex items-center rounded-md p-2 text-slate-700 hover:bg-slate-100 sm:hidden">
      <span class="sr-only">Toggle navigation</span>
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <nav id="mobile-nav" class="hidden border-t border-slate-200 sm:hidden">
    <div class="space-y-1 px-4 py-3">
      <% navLinks.forEach((link) => { %>
        <a href="<%= link.href %>"
          class="block rounded-md px-3 py-2 text-sm <%= isActive(link.href) ? 'bg-slate-100 font-medium text-slate-900' : 'text-slate-600 hover:bg-slate-50' %>">
          <%= link.label %>
        </a>
      <% }) %>
    </div>
  </nav>
</header>
