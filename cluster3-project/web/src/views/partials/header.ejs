<%#
  Site header shared by every page: brand, primary navigation, and the
  storefront controls taken from the home mockup.

  The active link is highlighted from `currentPath` (set on res.locals in
  app.js). The menu collapses into a toggle button below the `sm` breakpoint;
  the toggle is driven by /js/nav.js.

  The search field and the cart come from the mockup but are deliberately
  inert — neither Catalog nor Cart exists yet. `disabled` and a <span> in place
  of a link keep both out of the tab order, so nothing focusable is
  unresponsive to a keyboard or a screen reader.
%>
<%
  const navLinks = [
    { href: '/', label: 'Home' },
    { href: '/about', label: 'About' },
    { href: '/mashup', label: 'Mashups' },
    { href: '/contact', label: 'Contact us' },
    { href: '/login', label: 'Login' },
  ];
  // Home matches only "/"; other links match their path and anything below it.
  const isActive = (href) =>
    href === '/' ? currentPath === '/' : currentPath.startsWith(href);
%>
<header class="fixed inset-x-0 top-0 z-40 border-b border-line bg-surface">
  <div class="mx-auto flex h-20 max-w-5xl items-center justify-between gap-6 px-4">
    <a href="/" class="flex flex-col leading-none">
      <span class="font-display text-xl font-bold tracking-tight text-ink">LPA</span>
      <span class="text-[10px] font-medium tracking-[0.2em] text-muted">ECOMMS</span>
    </a>

    <nav class="hidden gap-8 text-sm sm:flex">
      <% navLinks.forEach((link) => { %>
        <a href="<%= link.href %>"
          class="<%= isActive(link.href) ? 'border-b-2 border-accent pb-1 font-medium text-ink' : 'text-muted hover:text-ink' %>">
          <%= link.label %>
        </a>
      <% }) %>
    </nav>

    <div class="hidden items-center gap-4 sm:flex">
      <div class="flex w-56 items-center gap-2 rounded-full bg-subtle px-4 py-2.5">
        <svg class="h-4 w-4 shrink-0 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="search" placeholder="Search peripherals..." disabled title="Coming soon"
          class="w-full bg-transparent text-sm text-ink placeholder:text-muted focus:outline-none" />
      </div>

      <span aria-disabled="true" title="Coming soon"
        class="relative flex h-10 w-10 items-center justify-center rounded-full border border-line bg-surface text-ink">
        <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
          aria-hidden="true">
          <path d="M6 6h15l-1.5 9h-12z"></path>
          <circle cx="9" cy="20" r="1"></circle>
          <circle cx="18" cy="20" r="1"></circle>
        </svg>
        <span class="absolute -right-1 -top-1 flex h-4 w-4 items-center justify-center rounded-full bg-accent text-[9px] font-semibold text-white">0</span>
      </span>
    </div>

    <button type="button" id="nav-toggle" aria-controls="mobile-nav" aria-expanded="false"
      class="inline-flex items-center rounded-md p-2 text-ink hover:bg-subtle sm:hidden">
      <span class="sr-only">Toggle navigation</span>
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <nav id="mobile-nav" class="hidden border-t border-line sm:hidden">
    <div class="space-y-1 px-4 py-3">
      <% navLinks.forEach((link) => { %>
        <a href="<%= link.href %>"
          class="block rounded-md px-3 py-2 text-sm <%= isActive(link.href) ? 'bg-subtle font-medium text-ink' : 'text-muted hover:bg-subtle' %>">
          <%= link.label %>
        </a>
      <% }) %>
    </div>
  </nav>
</header>
