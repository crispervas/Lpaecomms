<%# One row of a mashup card's "Data sources" panel. Reuses the file-row shape
    the mockup used for "Included files": icon, a strong first line, a quiet
    second one. Included by the three mashup cards.

    Expected locals:
      endpoint — what the browser calls, or the library it loads
      source   — who serves it %>
<div class="data-source">
  <svg class="data-source__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
    stroke-width="2" aria-hidden="true">
    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
    <path d="M14 2v6h6" />
  </svg>
  <div class="data-source__body">
    <div class="data-source__endpoint"><%= endpoint %></div>
    <div class="data-source__origin"><%= source %></div>
  </div>
</div>
