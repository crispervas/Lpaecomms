<%# ── MASHUP 3 — Secure Password Checker ───────────────────────────
    Breach-check integration, in the Marshup mockup's card: copy and sources on
    top, the live widget across the full width below. Included by
    pages/mashup.ejs. Takes no locals: the checker fetches its own data. %>
<article aria-labelledby="mashup-3" class="mashup-card">
  <div class="mashup-card__head">
    <div class="mashup-card__intro">
      <%# The mockup puts a product photo here. There is no photo for an
          integration, so the column holds the purpose icon instead — sized to
          read as a deliberate plate rather than a gap where an image failed. %>
      <span class="mashup-card__icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
        </svg>
      </span>
      <div class="mashup-card__body">
        <div class="mashup-card__meta">
          <span class="badge badge--accent">
            Registration + Breach data
          </span>
          <span class="mashup-card__live">
            <span class="mashup-card__live-dot" aria-hidden="true"></span>Live
          </span>
        </div>
        <h2 id="mashup-3" class="mashup-card__title">Secure Password Checker</h2>
        <p class="mashup-card__text">
          Warns at registration when a chosen password has appeared in a known
          breach, and rates its strength. Only the first five characters of the
          hash ever leave the browser, so the password itself is never sent.
        </p>
      </div>
    </div>

    <div class="mashup-card__sources">
      <span class="mashup-card__sources-heading">Data sources</span>
      <%- include('./dataSource', { endpoint: 'GET /api/v1/password/breaches', source: 'Lpaecomms REST API' }) %>
      <%- include('./dataSource', { endpoint: 'Have I Been Pwned', source: 'Range search, k-anonymity' }) %>
    </div>
  </div>

  <%# The four strength segments carry no meaning on their own — colour alone is
      not an accessible signal — so they are aria-hidden and the label below
      states the level in words. The status line is a live region so the breach
      result is announced as it arrives. mashup-password.js rewrites the
      className of the segments, the label and the status line, so their classes
      here and there must be changed together. %>
  <div class="mashup-card__widget">
    <div class="widget-panel">
      <div class="password-check">
        <label for="mashup-password" class="password-check__label">Password</label>
        <input id="mashup-password" name="password" type="password" autocomplete="new-password"
          class="password-check__input" />

        <div class="strength">
          <div id="mashup-strength-bar" class="strength__bar" aria-hidden="true">
            <span class="strength__segment"></span>
            <span class="strength__segment"></span>
            <span class="strength__segment"></span>
            <span class="strength__segment"></span>
          </div>
          <p id="mashup-strength-label" class="strength__label">
            Strength: enter a password
          </p>
        </div>
      </div>

      <p id="mashup-breach-status" role="status" class="breach-status">
        Type a password to check it against known data breaches.
      </p>
    </div>
  </div>
</article>
