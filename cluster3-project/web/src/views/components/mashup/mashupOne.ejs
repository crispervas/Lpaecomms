<%# ── MASHUP 1 — Products + Location ───────────────────────────────
    Catalogue-on-a-map integration, in the Marshup mockup's card: copy and
    sources on top, the live widget across the full width below. Included by
    pages/mashup.ejs. Takes no locals: the map fetches its own data. %>
<article aria-labelledby="mashup-1" class="mashup-card">
  <div class="mashup-card__head">
    <div class="mashup-card__intro">
      <%# The mockup puts a product photo here. There is no photo for an
          integration, so the column holds the purpose icon instead — sized to
          read as a deliberate plate rather than a gap where an image failed. %>
      <span class="mashup-card__icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
        </svg>
      </span>
      <div class="mashup-card__body">
        <div class="mashup-card__meta">
          <span class="badge badge--accent">
            Catalogue + Maps
          </span>
          <span class="mashup-card__live">
            <span class="mashup-card__live-dot" aria-hidden="true"></span>Live
          </span>
        </div>
        <h2 id="mashup-1" class="mashup-card__title">Products + Location</h2>
        <p class="mashup-card__text">
          Shows customers where products are physically available, on a map they
          can pan and zoom. Store coordinates are paired with the catalogue in
          the page, because products carry none of their own.
        </p>
      </div>
    </div>

    <div class="mashup-card__sources">
      <span class="mashup-card__sources-heading">Data sources</span>
      <%- include('./dataSource', { endpoint: 'GET /api/v1/products', source: 'Lpaecomms REST API' }) %>
      <%- include('./dataSource', { endpoint: 'Leaflet 1.9.4', source: 'Map rendering' }) %>
      <%- include('./dataSource', { endpoint: 'OpenStreetMap', source: 'Map tiles' }) %>
    </div>
  </div>

  <%# Leaflet renders into this container. mashup-map.js replaces this
      className wholesale when the catalogue cannot be read, so the two must be
      changed together. %>
  <div class="mashup-card__widget">
    <div id="mashup-map" role="region" aria-label="Map of stores holding these products"
      class="mashup-map" data-stores="<%= JSON.stringify(storeLocations) %>"></div>
    <p class="mashup-map__attribution">Map data © OpenStreetMap contributors</p>
  </div>
</article>
