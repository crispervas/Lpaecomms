<%# ── MASHUP 2 — Products + Currency Converter ─────────────────────
    Price-conversion integration, in the Marshup mockup's card: copy and
    sources on top, the live widget across the full width below. Included by
    pages/mashup.ejs. Takes no locals: the converter fetches its own data. %>
<article aria-labelledby="mashup-2" class="mashup-card">
  <div class="mashup-card__head">
    <div class="mashup-card__intro">
      <%# The mockup puts a product photo here. There is no photo for an
          integration, so the column holds the purpose icon instead — sized to
          read as a deliberate plate rather than a gap where an image failed. %>
      <span class="mashup-card__icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="1.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
        </svg>
      </span>
      <div class="mashup-card__body">
        <div class="mashup-card__meta">
          <span class="badge badge--accent">
            Catalogue + Exchange rates
          </span>
          <span class="mashup-card__live">
            <span class="mashup-card__live-dot" aria-hidden="true"></span>Live
          </span>
        </div>
        <h2 id="mashup-2" class="mashup-card__title">Products + Currency Converter</h2>
        <p class="mashup-card__text">
          Converts a product's price into the customer's currency beside the
          price, without reloading the page. Rates are fetched once per pair and
          cached, so changing product does not spend a new call.
        </p>
      </div>
    </div>

    <div class="mashup-card__sources">
      <span class="mashup-card__sources-heading">Data sources</span>
      <%- include('./dataSource', { endpoint: 'GET /api/v1/products', source: 'Lpaecomms REST API' }) %>
      <%- include('./dataSource', { endpoint: 'GET /api/v1/convert', source: 'API Ninjas exchange rates' }) %>
    </div>
  </div>

  <%# Both selectors start empty of data: the product list arrives from
      /api/v1/products in the browser. The status line is a live region so a
      screen reader announces the converted price without the user re-reading
      the block. %>
  <div class="mashup-card__widget">
    <div class="widget-panel">
      <div class="converter__controls">
        <div>
          <label for="mashup-product" class="field-label">Product</label>
          <select id="mashup-product" name="product" class="select">
            <option value="">Loading products…</option>
          </select>
        </div>
        <div>
          <label for="mashup-currency" class="field-label">Display currency</label>
          <select id="mashup-currency" name="currency" class="select">
            <option value="AUD">AUD</option>
            <option value="USD">USD</option>
            <option value="GBP">GBP</option>
            <option value="EUR">EUR</option>
          </select>
        </div>
      </div>

      <div class="converter__result">
        <div>
          <p class="converter__label">Base price</p>
          <p id="mashup-base-price" class="converter__base">—</p>
        </div>
        <div class="converter__converted-group">
          <p class="converter__label">Converted</p>
          <p id="mashup-converted-price" class="converter__converted">—</p>
        </div>
      </div>

      <p id="mashup-convert-status" role="status" class="converter__status">
        Choose a product to see its price converted.
      </p>
    </div>
  </div>
</article>
