<%#
  Home hero: headline, calls to action, and the hero image.

  Expected locals:
    heroImage — public URL of the hero image, or null when none was supplied.
                Without it the tinted block renders alone, which is a
                deliberate composition rather than a hole in the page.
%>
<section class="hero">
  <div>
    <span class="eyebrow">
      New arrivals — Precision Series
    </span>
    <h1 class="hero__title">
      Peripherals engineered for focus.
    </h1>
    <p class="hero__lead">
      Keyboards, mice and headsets built for people who work at a desk all day
      and refuse to settle for cheap plastic.
    </p>
    <div class="hero__actions">
      <a href="#trending" class="button button--solid">
        Shop trending
      </a>
      <a href="/mashup" class="button button--outline">
        Explore Mashups
      </a>
    </div>
  </div>

  <div class="hero__media">
    <div class="hero__shape" aria-hidden="true"></div>
    <% if (heroImage) { %>
      <img src="<%= heroImage %>" alt="An online storefront on a phone, with a shopping basket and a customer browsing"
        class="hero__image" />
    <% } %>
  </div>
</section>
