<%#
  Product gallery: the main image and a strip of the product's other images.

  Expected locals:
    imageUrls — array of image URLs in feed order. May be empty.
    name      — the product's name, used as the main image's alt text.

  The first image is the main one and the strip holds the rest, so no image
  appears twice. The strip renders only when there is more than one: a strip of
  one is not a strip.

  The thumbnails carry an empty alt deliberately. They are further views of the
  subject the main image already names, so repeating that name would turn the
  strip into noise for a screen reader without adding anything.
%>
<div class="gallery">
  <div class="gallery__main">
    <%# The feed does not always carry a usable image; the tinted block stands
        in rather than a broken-image icon. %>
    <% if (imageUrls.length) { %>
      <img src="<%= imageUrls[0] %>" alt="<%= name %>" class="gallery__image" />
    <% } %>
  </div>

  <% if (imageUrls.length > 1) { %>
    <div class="gallery__thumbs">
      <% imageUrls.slice(1).forEach((url) => { %>
        <div class="gallery__thumb">
          <img src="<%= url %>" alt="" loading="lazy" class="gallery__image" />
        </div>
      <% }) %>
    </div>
  <% } %>
</div>
