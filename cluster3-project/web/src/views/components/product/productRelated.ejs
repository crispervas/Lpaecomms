<%#
  "You might also like": other products from the same category.

  Expected locals:
    products       — array of {id, name, category, priceAud, imageUrl}, never
                     containing the product being viewed. Empty when the
                     category listing could not be fetched, or when the product
                     has no category to be related to.
    priceFormatter — an Intl.NumberFormat, shared with the rest of the page.

  Renders nothing at all when the list is empty: a heading over an empty row
  would promise something the section cannot deliver.
%>
<% if (products.length) { %>
  <section class="related">
    <h2 class="section-heading">You might also like</h2>
    <div class="product-grid">
      <% products.forEach((product) => { %>
        <%- include('../shared/productCard', { product, priceFormatter }) %>
      <% }) %>
    </div>
  </section>
<% } %>
