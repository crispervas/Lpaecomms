<%# ── MASHUP 2 — Products + Currency Converter ─────────────────────
    Card previewing the price-conversion integration. Included by
    pages/mashup.ejs. Takes no locals: the converter fetches its own data. %>
<article aria-labelledby="mashup-2" class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
  <div class="flex items-start gap-4">
    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600">
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
    </span>
    <div class="min-w-0 flex-1">
      <div class="flex items-start justify-between gap-3">
        <h2 id="mashup-2" class="text-lg font-semibold">Products + Currency Converter</h2>
        <span class="shrink-0 rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-1 text-xs font-medium text-emerald-700">Live</span>
      </div>
      <p class="mt-1 text-sm text-slate-600">
        Convert a product's price into the customer's currency right next to
        the price, without reloading the page.
      </p>
      <p class="mt-2 text-xs font-medium uppercase tracking-wide text-slate-500">
        Combines: Lpaecomms catalogue + API Ninjas exchange rates
      </p>
    </div>
  </div>

  <%# Both selectors start empty of data: the product list arrives from
      /api/v1/products in the browser. The status line is a live region so a
      screen reader announces the converted price without the user re-reading
      the block. %>
  <div class="mt-5 rounded-lg border border-slate-200 bg-slate-50 p-5">
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label for="mashup-product" class="block text-xs font-medium text-slate-600">Product</label>
        <select id="mashup-product" name="product"
          class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700">
          <option value="">Loading products…</option>
        </select>
      </div>
      <div>
        <label for="mashup-currency" class="block text-xs font-medium text-slate-600">Display currency</label>
        <select id="mashup-currency" name="currency"
          class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700">
          <option value="AUD">AUD</option>
          <option value="USD">USD</option>
          <option value="GBP">GBP</option>
          <option value="EUR">EUR</option>
        </select>
      </div>
    </div>

    <div class="mt-5 flex flex-col gap-4 border-t border-slate-200 pt-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-xs uppercase tracking-wide text-slate-500">Base price</p>
        <p id="mashup-base-price" class="mt-1 text-lg font-medium text-slate-700">—</p>
      </div>
      <div class="sm:text-right">
        <p class="text-xs uppercase tracking-wide text-slate-500">Converted</p>
        <p id="mashup-converted-price" class="mt-1 text-3xl font-semibold tracking-tight text-slate-900">—</p>
      </div>
    </div>

    <p id="mashup-convert-status" role="status" class="mt-3 text-sm text-slate-500">
      Choose a product to see its price converted.
    </p>
  </div>
</article>
