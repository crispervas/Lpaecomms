<%#
  Catalog results: the count label, the product grid, and the empty states.

  Expected locals:
    products           — array of {id, name, category, priceAud, imageUrl}
    catalogueAvailable — false when the feed could not be read
    activeCategory     — the selected category object, or null/undefined for
                          the unfiltered view; only its presence is read here,
                          to choose which empty-state wording applies
    q                  — the search text, '' for none
    total              — how many products match across every page

  An empty `products` means two different things, and the page must not blur
  them: a feed that fell over is not a category that happens to be empty.
  Telling someone a category is empty when the catalogue is actually down is a
  lie the page can easily avoid, which is why the `catalogueAvailable` flag
  exists.

  A legitimately empty result also reads differently depending on whether a
  category was chosen: "No products in this category" is false when no
  category was selected at all, so the unfiltered view gets its own wording.

  The count label renders only alongside a populated grid: pairing
  "Showing 0 products" with a notice that already explains the emptiness says
  the same thing twice, once uselessly.
%>
<section class="catalog-results">
  <% if (!catalogueAvailable) { %>
    <p class="empty-note">Our catalogue is unavailable right now. Please check back shortly.</p>
  <% } else if (!products.length && q) { %>
    <p class="empty-note empty-note--page">
      No products match “<%= q %>”. <a href="/catalog">See all products</a>.
    </p>
  <% } else if (!products.length) { %>
    <p class="empty-note empty-note--page">
      <%= activeCategory ? 'No products in this category yet.' : 'No products available yet.' %>
    </p>
  <% } else { %>
    <%
      // Built once per render rather than per card: constructing an Intl
      // formatter is the expensive part, formatting with it is not.
      const priceFormatter = new Intl.NumberFormat('en-AU', {
        style: 'currency',
        currency: 'AUD',
      });
    %>
    <p class="catalog-results__count">
      Showing <%= products.length %> of <%= total %> product<%= total === 1 ? '' : 's' %>
    </p>
    <div class="product-grid">
      <% products.forEach((product) => { %>
        <%- include('../shared/productCard', { product, priceFormatter }) %>
      <% }) %>
    </div>
  <% } %>
</section>
