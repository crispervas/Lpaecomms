<%#
  Home hero: headline, calls to action, and the hero image.

  Expected locals:
    heroImage — public URL of the hero image, or null when none was supplied.
                Without it the tinted block renders alone, which is a
                deliberate composition rather than a hole in the page.
%>
<section class="grid items-center gap-10 py-14 lg:grid-cols-2 lg:py-20">
  <div>
    <span class="text-xs font-semibold uppercase tracking-[0.15em] text-accent">
      New arrivals — Precision Series
    </span>
    <h1 class="mt-5 font-display text-4xl font-bold leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl">
      Peripherals engineered for focus.
    </h1>
    <p class="mt-6 max-w-md text-lg leading-relaxed text-muted">
      Keyboards, mice and headsets built for people who work at a desk all day
      and refuse to settle for cheap plastic.
    </p>
    <div class="mt-9 flex flex-wrap gap-3.5">
      <a href="#trending"
        class="rounded-lg bg-ink px-8 py-4 text-sm font-semibold text-white hover:bg-black">
        Shop trending
      </a>
      <a href="/mashup"
        class="rounded-lg border border-line-strong px-8 py-4 text-sm font-semibold text-ink hover:bg-surface">
        Explore Mashups
      </a>
    </div>
  </div>

  <div class="relative h-[320px] sm:h-[420px] lg:h-[520px]">
    <div class="absolute right-0 top-5 h-[88%] w-[88%] rounded-3xl bg-tint" aria-hidden="true"></div>
    <% if (heroImage) { %>
      <%# object-contain, not object-cover: the supplied artwork is an
          illustration with margin around it, and cover would fill the box by
          cropping those edges away. %>
      <img src="<%= heroImage %>" alt="An online storefront on a phone, with a shopping basket and a customer browsing"
        class="absolute bottom-0 left-0 h-[90%] w-[92%] rounded-3xl object-contain" />
    <% } %>
  </div>
</section>
