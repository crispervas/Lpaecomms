<%#
  "Shop by category" grid. No locals.

  The six categories are markup, not business data — there is no category
  service and these icons exist nowhere else — so the list lives here instead
  of travelling through the controller. The cards carry no link and no
  cursor-pointer: the mockup's names (Keyboards, Mice, Headsets, Monitors,
  Webcams, Docks) match none of the feed's real categories (clothes,
  electronics, furniture, shoes, miscellaneous), so there is no
  `/catalog?category=…` URL for a card to point at.
%>
<%
  const categories = [
    {
      name: 'Keyboards',
      icon: '<rect x="2" y="6" width="20" height="12" rx="2"></rect><line x1="7" y1="15" x2="17" y2="15"></line>',
    },
    {
      name: 'Mice',
      icon: '<rect x="7" y="3" width="10" height="18" rx="5"></rect><line x1="12" y1="3" x2="12" y2="10"></line>',
    },
    {
      name: 'Headsets',
      icon: '<path d="M4 13v3a2 2 0 002 2h1v-6H6a2 2 0 00-2 1z"></path><path d="M20 13v3a2 2 0 01-2 2h-1v-6h1a2 2 0 012 1z"></path><path d="M4 13a8 8 0 0116 0"></path>',
    },
    {
      name: 'Monitors',
      icon: '<rect x="3" y="4" width="18" height="12" rx="2"></rect><line x1="8" y1="20" x2="16" y2="20"></line><line x1="12" y1="16" x2="12" y2="20"></line>',
    },
    {
      name: 'Webcams',
      icon: '<circle cx="12" cy="12" r="5"></circle><circle cx="12" cy="12" r="1.5"></circle><path d="M4 6l2 2M20 6l-2 2"></path>',
    },
    {
      name: 'Docks',
      icon: '<rect x="4" y="9" width="16" height="7" rx="1.5"></rect><line x1="8" y1="16" x2="8" y2="18"></line><line x1="16" y1="16" x2="16" y2="18"></line>',
    },
  ];
%>
<section class="pb-16">
  <h2 class="mb-7 font-display text-xl font-semibold">Shop by category</h2>
  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
    <% categories.forEach((category) => { %>
      <div class="flex flex-col items-center gap-3 rounded-2xl border border-line bg-surface px-3 py-7">
        <span class="flex h-11 w-11 items-center justify-center rounded-full bg-tint text-accent">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            aria-hidden="true"><%- category.icon %></svg>
        </span>
        <span class="text-sm font-medium text-ink"><%= category.name %></span>
      </div>
    <% }) %>
  </div>
</section>
