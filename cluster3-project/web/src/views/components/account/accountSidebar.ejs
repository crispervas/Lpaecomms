<%# The Account page's left column: who is signed in, then the tab switch.

    The mockup draws the switch as buttons driven by a script. Here they are
    links, like the login tabs: the server decides the tab, so both are
    reachable with no JavaScript and each has its own shareable URL.

    "Log out" is a POST form, like the header's: a GET link would let any
    page sign the customer out with an image tag.

    Expected locals:
      tab      — 'profile' or 'orders', the tab currently shown
      profile  — the stored profile (name, lastName and email are shown)
      initials — the avatar letters, e.g. "JK" %>
<%
  const tabs = [
    {
      key: 'profile',
      href: '/account',
      label: 'Profile',
      icon: '<circle cx="12" cy="8" r="4"></circle><path d="M4 21v-1a8 8 0 0116 0v1"></path>',
    },
    {
      key: 'orders',
      href: '/account?tab=orders',
      label: 'Orders',
      icon: '<path d="M4 4h16l-1.5 16h-13z"></path><path d="M8 4V3a2 2 0 012-2h4a2 2 0 012 2v1"></path>',
    },
  ];
%>
<aside class="account-sidebar">
  <div class="account-card">
    <%# Decorative: the name beside it says who this is. %>
    <span class="account-card__avatar" aria-hidden="true"><%= initials %></span>
    <div>
      <p class="account-card__name"><%= profile.name %> <%= profile.lastName %></p>
      <p class="account-card__email"><%= profile.email %></p>
    </div>
  </div>

  <nav class="account-nav" aria-label="Account">
    <% tabs.forEach((item) => { %>
      <a href="<%= item.href %>"
        <% if (item.key === tab) { %>aria-current="page"<% } %>
        class="account-nav__link<%= item.key === tab ? ' is-active' : '' %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><%- item.icon %></svg>
        <%= item.label %>
      </a>
    <% }) %>

    <hr class="account-nav__divider" />

    <form method="post" action="/logout">
      <button type="submit" class="account-nav__link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"></path>
          <path d="M16 17l5-5-5-5"></path>
          <path d="M21 12H9"></path>
        </svg>
        Log out
      </button>
    </form>
  </nav>
</aside>
