<%# "Visit the workshop": the Leaflet map beside the address and opening hours.

    The address here must agree with the coordinates in public/js/contact-map.js
    (-27.9685, 153.4144 — Australia Fair, Southport), which is also one of the
    catalogue's store locations. The mockup this layout comes from says 441
    Harrison St, San Francisco; following it would caption the pin with an
    address a hemisphere away.

    Included by pages/contact.ejs. Takes no locals: the map fetches nothing and
    the details are static. %>
<section class="workshop">
  <h2 class="workshop__heading">Visit the workshop</h2>

  <div class="workshop__panel">
    <%# Leaflet renders into this container. It needs an explicit height, and
        isolation keeps Leaflet's internal z-indexes from covering the fixed
        header. Initialised by /js/contact-map.js, which finds it by id. %>
    <div id="contact-map" role="region" aria-label="Map of the Lpaecomms location"
      class="workshop-map"></div>

    <div class="workshop__details">
      <div>
        <div class="workshop__name">Lpaecomms Workshop</div>
        <div class="workshop__address">
          Australia Fair, Marine Parade<br />Southport QLD 4215
        </div>
      </div>

      <div class="workshop__rule"></div>

      <div>
        <div class="workshop__hours-label">Hours</div>
        <div class="workshop__hours">
          Tue–Fri, 10am–4pm AEST<br />By appointment only
        </div>
      </div>

      <a href="https://www.openstreetmap.org/?mlat=-27.9685485&amp;mlon=153.4144003#map=17/-27.9685485/153.4144003"
        target="_blank" rel="noopener noreferrer" class="workshop__directions">
        Get directions
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
          stroke-width="2" aria-hidden="true">
          <path d="M7 17 17 7M9 7h8v8" />
        </svg>
        <span class="u-visually-hidden">(opens OpenStreetMap in a new tab)</span>
      </a>
    </div>
  </div>
</section>
