<%# Contact channels: the three ways to reach the store, as the mockup's stacked
    cards. Static markup — none of this is read from a model. Included by
    pages/contact.ejs. Takes no locals. %>
<div class="channel-list">
  <div class="channel">
    <span class="channel__icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2" aria-hidden="true">
        <path d="M4 6h16v12H4z" />
        <path d="M4 7l8 6 8-6" />
      </svg>
    </span>
    <div>
      <div class="channel__name">Email support</div>
      <div class="channel__value">support@lpaecomms.com</div>
      <div class="channel__note">Replies within 1 business day</div>
    </div>
  </div>

  <div class="channel">
    <span class="channel__icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2" aria-hidden="true">
        <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 3a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.2-1.3a2 2 0 0 1 2.1-.5c1 .3 2 .5 3 .7a2 2 0 0 1 1.7 2z" />
      </svg>
    </span>
    <div>
      <div class="channel__name">Phone</div>
      <div class="channel__value">+61 7 5500 0148</div>
      <div class="channel__note">Mon–Fri, 9am–6pm AEST</div>
    </div>
  </div>

  <div class="channel">
    <span class="channel__icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2" aria-hidden="true">
        <path d="M12 22s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12z" />
        <circle cx="12" cy="10" r="2.5" />
      </svg>
    </span>
    <div>
      <div class="channel__name">Studio</div>
      <div class="channel__value">Australia Fair, Southport QLD</div>
      <div class="channel__note">By appointment only</div>
    </div>
  </div>
</div>
