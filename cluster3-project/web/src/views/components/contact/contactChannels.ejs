<%# Contact channels: the three ways to reach the store, as the mockup's stacked
    cards. Static markup — none of this is read from a model. Included by
    pages/contact.ejs. Takes no locals. %>
<div class="flex flex-col gap-7">
  <div class="flex items-start gap-4 rounded-2xl border border-line bg-surface p-6">
    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-tint text-accent">
      <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2" aria-hidden="true">
        <path d="M4 6h16v12H4z" />
        <path d="M4 7l8 6 8-6" />
      </svg>
    </span>
    <div>
      <div class="text-[15px] font-semibold">Email support</div>
      <div class="mt-1 text-sm text-muted">support@lpaecomms.com</div>
      <div class="mt-0.5 text-xs text-muted">Replies within 1 business day</div>
    </div>
  </div>

  <div class="flex items-start gap-4 rounded-2xl border border-line bg-surface p-6">
    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-tint text-accent">
      <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2" aria-hidden="true">
        <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 3a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.2-1.3a2 2 0 0 1 2.1-.5c1 .3 2 .5 3 .7a2 2 0 0 1 1.7 2z" />
      </svg>
    </span>
    <div>
      <div class="text-[15px] font-semibold">Phone</div>
      <div class="mt-1 text-sm text-muted">+61 7 5500 0148</div>
      <div class="mt-0.5 text-xs text-muted">Mon–Fri, 9am–6pm AEST</div>
    </div>
  </div>

  <div class="flex items-start gap-4 rounded-2xl border border-line bg-surface p-6">
    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-tint text-accent">
      <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2" aria-hidden="true">
        <path d="M12 22s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12z" />
        <circle cx="12" cy="10" r="2.5" />
      </svg>
    </span>
    <div>
      <div class="text-[15px] font-semibold">Studio</div>
      <div class="mt-1 text-sm text-muted">Australia Fair, Southport QLD</div>
      <div class="mt-0.5 text-xs text-muted">By appointment only</div>
    </div>
  </div>
</div>
