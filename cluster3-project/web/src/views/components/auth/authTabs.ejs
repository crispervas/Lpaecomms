<%# The Log in / Sign up switch, as the mockup's segmented control.

    Rendered as links rather than buttons, and that is the whole point: the
    server decides the mode, so the switch works with no JavaScript at all. A
    pair of buttons would need a script to do anything, and without one the
    sign-up form would be unreachable.

    Expected locals:
      mode — 'login' or 'signup', the tab currently shown
      next — where a successful sign-in goes; kept by both tabs so switching
             to sign-up on the way to the checkout still ends at the checkout %>
<%
  const nextParam = next && next !== '/account' ? `next=${encodeURIComponent(next)}` : '';
  const tabs = [
    { key: 'login', href: nextParam ? `/login?${nextParam}` : '/login', label: 'Log in' },
    { key: 'signup', href: `/login?tab=signup${nextParam ? `&${nextParam}` : ''}`, label: 'Sign up' },
  ];
%>
<div class="auth-tabs">
  <% tabs.forEach((tab) => { %>
    <a href="<%= tab.href %>"
      <% if (tab.key === mode) { %>aria-current="page"<% } %>
      class="auth-tabs__tab<%= tab.key === mode ? ' is-active' : '' %>">
      <%= tab.label %>
    </a>
  <% }) %>
</div>
