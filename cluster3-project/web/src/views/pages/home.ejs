<%# Home page content. Wrapped by layouts/base.ejs. %>
<section class="text-center">
  <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
    Computer peripherals, sorted.
  </h1>
  <p class="mx-auto mt-4 max-w-xl text-lg text-slate-600">
    Welcome to Lpaecomms — the online store for keyboards, mice, headsets,
    webcams, and everything around your desk.
  </p>
  <div class="mt-8 flex flex-wrap justify-center gap-3">
    <%# Points to the catalogue once it exists. %>
    <a href="/"
      class="rounded-md bg-slate-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-slate-700">
      Shop peripherals
    </a>
    <a href="/about"
      class="rounded-md border border-slate-300 px-5 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50">
      Learn more
    </a>
  </div>
</section>

<section class="mt-16">
  <h2 class="text-center text-sm font-semibold uppercase tracking-wide text-slate-500">
    Browse by category
  </h2>
  <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
    <% ['Keyboards', 'Mice', 'Headsets', 'Webcams'].forEach((category) => { %>
      <div class="rounded-lg border border-slate-200 bg-white p-6 text-center">
        <p class="font-medium"><%= category %></p>
        <p class="mt-1 text-xs text-slate-500">Coming soon</p>
      </div>
    <% }) %>
  </div>
</section>
