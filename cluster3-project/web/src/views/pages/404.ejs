<%# 404 (Not Found) page content. Wrapped by layouts/base.ejs. %>
<section class="mx-auto max-w-lg py-16 text-center">
  <%# Oversized status code as the visual anchor. aria-hidden so screen readers
      hear the heading below, not the bare number. %>
  <p class="text-7xl font-bold tracking-tight text-slate-300 sm:text-8xl" aria-hidden="true">404</p>

  <h1 class="mt-4 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
    Page not found
  </h1>

  <p class="mx-auto mt-4 max-w-md text-slate-600">
    The page you are looking for doesn't exist, was moved, or is no longer
    available. Check the address or head back to the store.
  </p>

  <%# Only show the failed URL when the handler passes it. The url is printed
      with escaped output so a crafted path can't inject markup. %>
  <% if (typeof url !== 'undefined' && url) { %>
    <p class="mt-3 break-all text-sm text-slate-400">
      Requested: <code class="rounded bg-slate-100 px-1.5 py-0.5 text-slate-600"><%= url %></code>
    </p>
  <% } %>

  <div class="mt-8 flex flex-wrap justify-center gap-3">
    <a href="/"
      class="rounded-md bg-slate-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-slate-700">
      Back to home
    </a>
    <a href="/contact"
      class="rounded-md border border-slate-300 px-5 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50">
      Contact support
    </a>
  </div>
</section>
