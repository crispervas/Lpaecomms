<%# 404 (Not Found) page content. Wrapped by layouts/base.ejs. %>
<section class="error-page">
  <%# Oversized status code as the visual anchor. aria-hidden so screen readers
      hear the heading below, not the bare number. %>
  <p class="error-page__code" aria-hidden="true">404</p>

  <h1 class="error-page__title">
    Page not found
  </h1>

  <p class="error-page__text">
    The page you are looking for doesn't exist, was moved, or is no longer
    available. Check the address or head back to the store.
  </p>

  <%# Only show the failed URL when the handler passes it. The url is printed
      with escaped output so a crafted path can't inject markup. %>
  <% if (typeof url !== 'undefined' && url) { %>
    <p class="error-page__url">
      Requested: <code class="error-page__code-inline"><%= url %></code>
    </p>
  <% } %>

  <div class="error-page__actions">
    <a href="/" class="button button--solid button--compact">
      Back to home
    </a>
    <a href="/contact" class="button button--outline button--compact">
      Contact support
    </a>
  </div>
</section>
