<%# Mashups page: three live integrations, each combining Lpaecomms' own page
    with an external service. The page itself carries no data — every card
    fetches from /api/v1 in the browser, which is the same contract the mobile
    and desktop clients use. Wrapped by layouts/base.ejs. %>
<section class="mx-auto max-w-4xl">
  <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Mashups</h1>
  <p class="mt-4 max-w-2xl text-slate-600">
    A mashup blends data or services from more than one source into a single
    view. Each integration below combines Lpaecomms' own page with an external
    service, live.
  </p>

  <%# Each mashup is its own component under views/components/mashup. The paths are
      literal so a wrong name fails loudly at include time and stays greppable.
      None of them takes locals: their data arrives over the API. %>
  <div class="mt-10 space-y-8">
    <%- include('../components/mashup/mashupOne') %>
    <%- include('../components/mashup/mashupTwo') %>
    <%- include('../components/mashup/mashupThree') %>
  </div>
</section>
