<%# Mashups page: UI previews for the agreed mashups. Layout only — the
    controls are non-interactive and no external service is wired here. Built
    incrementally, one mashup at a time. Wrapped by layouts/base.ejs. %>
<section class="mx-auto max-w-4xl">
  <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Mashups</h1>
  <p class="mt-4 max-w-2xl text-slate-600">
    A mashup blends data or services from more than one source into a single
    view. The integration below combines LPA's own data with an external
    service. Every control here is a non-interactive preview of the layout;
    the live integration is wired separately.
  </p>

  <div class="mt-10 space-y-8">
    <%# ── MASHUP 1 — Products + Location ─────────────────────────────── %>
    <article aria-labelledby="mashup-1" class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <div class="flex items-start gap-4">
        <%# Purpose icon: a coloured chip makes each mashup scannable at a
            glance. Decorative, so the SVG is aria-hidden. %>
        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
          </svg>
        </span>
        <div class="min-w-0 flex-1">
          <div class="flex items-start justify-between gap-3">
            <h2 id="mashup-1" class="text-lg font-semibold">Products + Location</h2>
            <span class="shrink-0 rounded-full border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-slate-500">UI preview</span>
          </div>
          <p class="mt-1 text-sm text-slate-600">
            Show customers where products are physically available on an
            interactive map they can pan and zoom.
          </p>
          <p class="mt-2 text-xs font-medium uppercase tracking-wide text-slate-500">
            Combines: LPA catalogue + Leaflet + OpenStreetMap
          </p>
        </div>
      </div>

      <%# Static placeholder standing in for the interactive map. %>
      <div class="mt-5 flex h-64 flex-col items-center justify-center rounded-lg border-2 border-dashed border-slate-300 bg-slate-50 text-center text-slate-500">
        <span class="flex h-12 w-12 items-center justify-center rounded-full bg-white text-blue-600 shadow-sm">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
          </svg>
        </span>
        <p class="mt-3 text-sm font-medium text-slate-700">Interactive map</p>
        <p class="mt-0.5 text-xs">Placeholder — the live map runs on the Contact page</p>
      </div>
      <p class="mt-2 text-xs text-slate-500">Map data © OpenStreetMap</p>
    </article>

     <%# ── MASHUP 2 — Products + Currency Converter ───────────────────── %>
    <article aria-labelledby="mashup-2" class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
      <div class="flex items-start gap-4">
        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600">
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
          </svg>
        </span>
        <div class="min-w-0 flex-1">
          <div class="flex items-start justify-between gap-3">
            <h2 id="mashup-2" class="text-lg font-semibold">Products + Currency Converter</h2>
            <span class="shrink-0 rounded-full border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-slate-500">UI preview</span>
          </div>
          <p class="mt-1 text-sm text-slate-600">
            Convert a product's price into the customer's currency right next to
            the price, without reloading the page.
          </p>
          <p class="mt-2 text-xs font-medium uppercase tracking-wide text-slate-500">
            Combines: LPA price + API Ninjas exchange rates
          </p>
        </div>
      </div>

      <%# Product row with a currency selector next to the base price. The
          selector is disabled: no live conversion happens in this preview. %>
      <div class="mt-5 rounded-lg border border-slate-200 bg-slate-50 p-5">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-sm text-slate-500">Wireless Mouse</p>
            <p class="mt-1 text-3xl font-semibold tracking-tight text-slate-900">AUD $92.34</p>
          </div>
          <div class="sm:w-40">
            <label for="currency" class="block text-xs font-medium text-slate-600">Display currency</label>
            <select id="currency" name="currency" disabled aria-disabled="true"
              class="mt-1 w-full cursor-not-allowed rounded-md border border-slate-300 bg-white px-3 py-2 text-sm text-slate-700">
              <option>AUD</option>
              <option>USD</option>
              <option>GBP</option>
              <option>EUR</option>
            </select>
          </div>
        </div>
        <div class="mt-4 flex items-center gap-2 border-t border-slate-200 pt-4 text-sm text-slate-500">
          <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
          </svg>
          <span>Converted price appears here</span>
        </div>
      </div>
    </article>

  </div>
</section>
