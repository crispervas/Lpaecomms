<%# Mashups page content. Wrapped by layouts/base.ejs. %>
<section class="mx-auto max-w-3xl">
  <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Mashups</h1>
  <p class="mt-4 text-slate-600">
    Content combined from more than one external source into a single view.
    The integrations below are planned; each pulls live data from external
    services and blends it into the store.
  </p>

  <div class="mt-10 grid gap-6 sm:grid-cols-2">
    <div class="rounded-lg border border-slate-200 bg-white p-6">
      <h2 class="font-semibold">Product social feed</h2>
      <p class="mt-2 text-sm text-slate-600">
        Review videos and community discussion for each peripheral, pulled from
        social platforms.
      </p>
      <p class="mt-3 text-xs font-medium uppercase tracking-wide text-slate-400">Coming soon</p>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-6">
      <h2 class="font-semibold">Delivery map</h2>
      <p class="mt-2 text-sm text-slate-600">
        A map of pickup points and delivery estimates, built from mapping and
        geocoding services.
      </p>
      <p class="mt-3 text-xs font-medium uppercase tracking-wide text-slate-400">Coming soon</p>
    </div>
  </div>
</section>
