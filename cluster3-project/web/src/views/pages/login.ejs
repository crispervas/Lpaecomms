<%# Login page: the mockup's split screen, tinted panel beside the form.

    Rendered with `bleed: true`, so it escapes the container the other pages sit
    in and runs edge to edge. The split screen is sized against the fixed
    header's height, which the layout has already cleared.

    Two modes share this page — see components/auth/authForm.ejs. Nothing here
    authenticates anyone; the auth controller says so on every submission. %>
<div class="auth">
  <%- include('../components/auth/authPanel') %>

  <div class="auth-form-column">
    <div class="auth-form-column__inner">
      <%- include('../components/auth/authTabs', { mode }) %>
      <%- include('../components/auth/authForm', { mode, fields, values, errors, notice }) %>
    </div>
  </div>
</div>
