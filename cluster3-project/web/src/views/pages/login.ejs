<%# Login page (form UI only; authentication is a separate slice). Wrapped by layouts/base.ejs. %>
<section class="mx-auto max-w-sm">
  <h1 class="text-3xl font-bold tracking-tight">Log in</h1>
  <p class="mt-3 text-slate-600">Access your Lpaecomms account.</p>

  <% if (notice) { %>
    <div class="mt-6 rounded-md border border-amber-200 bg-amber-50 p-4 text-sm text-amber-800">
      <%= notice %>
    </div>
  <% } %>

  <form method="post" action="/login" novalidate class="mt-6 space-y-5">
    <div>
      <label for="email" class="block text-sm font-medium">Email</label>
      <input id="email" name="email" type="email" value="<%= values.email %>"
        class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 focus:border-slate-500 focus:outline-none" />
    </div>

    <div>
      <label for="password" class="block text-sm font-medium">Password</label>
      <input id="password" name="password" type="password"
        class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 focus:border-slate-500 focus:outline-none" />
    </div>

    <button type="submit"
      class="w-full rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700">
      Log in
    </button>
  </form>
</section>
