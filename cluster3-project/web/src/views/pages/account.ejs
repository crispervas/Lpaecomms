<%# Account page: the mockup's sidebar beside whichever tab is selected.

    Two tabs share this URL — the profile form and the order history — and the
    server picks one from `?tab=`, so the sidebar's switch is plain links. The
    signed-in customer's own profile and orders; see the account controller. %>
<div class="account">
  <%- include('../components/account/accountSidebar', { tab, profile, initials }) %>

  <div class="account__content">
    <% if (tab === 'orders') { %>
      <%- include('../components/account/accountOrders', { orders }) %>
    <% } else { %>
      <%- include('../components/account/accountProfile', { profile, fields, values, errors, notice }) %>
    <% } %>
  </div>
</div>
