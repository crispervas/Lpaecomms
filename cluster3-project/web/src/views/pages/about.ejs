<%# About page content. Wrapped by layouts/base.ejs. %>
<section class="mx-auto max-w-3xl">
  <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">About Lpaecomms</h1>

  <p class="mt-4 text-slate-600">
    Lpaecomms is the online store for computer peripherals: keyboards, mice,
    headsets, webcams, and everything around your desk. We bring the full stock
    and sales catalogue online so you can browse, compare, and buy in a few
    steps.
  </p>

  <div class="mt-10 grid gap-6 sm:grid-cols-3">
    <div class="rounded-lg border border-slate-200 bg-white p-5">
      <h2 class="font-semibold">Curated peripherals</h2>
      <p class="mt-2 text-sm text-slate-600">
        A focused catalogue of the peripherals people actually use every day.
      </p>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-5">
      <h2 class="font-semibold">Live stock</h2>
      <p class="mt-2 text-sm text-slate-600">
        Availability is kept in sync with the central inventory across every
        Lpaecomms platform.
      </p>
    </div>
    <div class="rounded-lg border border-slate-200 bg-white p-5">
      <h2 class="font-semibold">Simple checkout</h2>
      <p class="mt-2 text-sm text-slate-600">
        A short, mobile-first path from product to purchase.
      </p>
    </div>
  </div>

  <div class="mt-12">
    <h2 class="text-2xl font-bold tracking-tight">What does Mashup mean?</h2>
    <%# Responsive YouTube embed. `aspect-video` (16:9) keeps the ratio at any
        width; the iframe fills the box. `title` names the frame for assistive
        tech. %>
    <div class="mt-6 aspect-video w-full overflow-hidden rounded-lg border border-slate-200">
      <iframe class="h-full w-full"
        src="https://www.youtube.com/embed/ZRcP2CZ8DS8"
        title="What does Mashup mean?"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        loading="lazy"
        allowfullscreen></iframe>
    </div>
  </div>
</section>
