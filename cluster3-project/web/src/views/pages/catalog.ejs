<%# Catalog page content. Wrapped by layouts/base.ejs. %>
<section class="catalog-head">
  <span class="eyebrow">Full catalog</span>
  <h1 class="catalog-head__title">
    <%= activeCategory ? activeCategory.name : 'All products' %>
  </h1>
</section>
<%# Nothing to filter by when the category list could not be read; the grid
    still renders on its own. %>
<% if (categories.length) { %>
  <%- include('../components/catalog/catalogFilters', {
    categories,
    activeSlug: activeCategory ? activeCategory.slug : null,
  }) %>
<% } %>
<%- include('../components/catalog/catalogResults', { products, catalogueAvailable, activeCategory }) %>
