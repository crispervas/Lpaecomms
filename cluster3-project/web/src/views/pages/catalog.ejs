<%# Catalog page content. Wrapped by layouts/base.ejs. %>
<section class="pt-4">
  <span class="text-xs font-semibold uppercase tracking-[0.15em] text-accent">Full catalog</span>
  <h1 class="mt-3.5 font-display text-3xl font-bold tracking-tight sm:text-4xl">
    <%= activeCategory ? activeCategory.name : 'All products' %>
  </h1>
</section>
<%# Nothing to filter by when the category list could not be read; the grid
    still renders on its own. %>
<% if (categories.length) { %>
  <%- include('../components/catalogFilters', {
    categories,
    activeSlug: activeCategory ? activeCategory.slug : null,
  }) %>
<% } %>
<%- include('../components/catalogResults', { products, catalogueAvailable, activeCategory }) %>
