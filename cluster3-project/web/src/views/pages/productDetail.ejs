<%# Product detail page content. Wrapped by layouts/base.ejs. %>
<%
  // Built once per render rather than per use: constructing an Intl formatter
  // is the expensive part, formatting with it is not.
  const priceFormatter = new Intl.NumberFormat('en-AU', {
    style: 'currency',
    currency: 'AUD',
  });
%>
<nav aria-label="Breadcrumb" class="breadcrumb">
  <ol class="breadcrumb__list">
    <li><a href="/" class="breadcrumb__link">Home</a></li>
    <li aria-hidden="true">/</li>
    <li><a href="/catalog" class="breadcrumb__link">Catalog</a></li>
    <%# The category crumb costs no extra request — it came with the product —
        and turns the trail into a way back rather than decoration. %>
    <% if (product.category.name && product.category.slug) { %>
      <li aria-hidden="true">/</li>
      <li>
        <a href="/catalog?category=<%= encodeURIComponent(product.category.slug) %>" class="breadcrumb__link">
          <%= product.category.name %>
        </a>
      </li>
    <% } %>
    <li aria-hidden="true">/</li>
    <li class="breadcrumb__current" aria-current="page"><%= product.name %></li>
  </ol>
</nav>

<section class="product-detail">
  <%- include('../components/product/productGallery', {
    imageUrls: product.imageUrls,
    name: product.name,
  }) %>

  <div>
    <% if (product.category.name) { %>
      <span class="badge badge--accent"><%= product.category.name %></span>
    <% } %>
    <h1 class="product-detail__title">
      <%= product.name %>
    </h1>
    <p class="product-detail__price"><%= priceFormatter.format(product.priceAud) %></p>
    <% if (product.description) { %>
      <p class="product-detail__description"><%= product.description %></p>
    <% } %>
    <%- include('../components/product/productPurchase', { productId: product.id, priceAud: product.priceAud, stock: product.stock, priceFormatter }) %>
  </div>
</section>

<%- include('../components/product/productRelated', { products: related, priceFormatter }) %>
