<%# Product detail page content. Wrapped by layouts/base.ejs. %>
<%
  // Built once per render rather than per use: constructing an Intl formatter
  // is the expensive part, formatting with it is not.
  const priceFormatter = new Intl.NumberFormat('en-AU', {
    style: 'currency',
    currency: 'AUD',
  });
%>
<nav aria-label="Breadcrumb" class="pt-6 text-xs text-muted">
  <ol class="flex flex-wrap items-center gap-1.5">
    <li><a href="/" class="hover:text-ink">Home</a></li>
    <li aria-hidden="true">/</li>
    <li><a href="/catalog" class="hover:text-ink">Catalog</a></li>
    <%# The category crumb costs no extra request — it came with the product —
        and turns the trail into a way back rather than decoration. %>
    <% if (product.category.name && product.category.slug) { %>
      <li aria-hidden="true">/</li>
      <li>
        <a href="/catalog?category=<%= encodeURIComponent(product.category.slug) %>" class="hover:text-ink">
          <%= product.category.name %>
        </a>
      </li>
    <% } %>
    <li aria-hidden="true">/</li>
    <li class="text-ink" aria-current="page"><%= product.name %></li>
  </ol>
</nav>

<section class="grid gap-12 pb-16 pt-8 lg:grid-cols-2 lg:gap-16">
  <%- include('../components/productGallery', {
    imageUrls: product.imageUrls,
    name: product.name,
  }) %>

  <div>
    <% if (product.category.name) { %>
      <span class="inline-block rounded-md bg-tint px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-accent">
        <%= product.category.name %>
      </span>
    <% } %>
    <h1 class="mt-4 font-display text-3xl font-bold tracking-tight sm:text-4xl">
      <%= product.name %>
    </h1>
    <p class="mt-3 font-display text-3xl font-bold"><%= priceFormatter.format(product.priceAud) %></p>
    <% if (product.description) { %>
      <p class="mt-6 text-base leading-relaxed text-muted"><%= product.description %></p>
    <% } %>
    <%- include('../components/productPurchase', { priceAud: product.priceAud, priceFormatter }) %>
  </div>
</section>

<%- include('../components/productRelated', { products: related, priceFormatter }) %>
