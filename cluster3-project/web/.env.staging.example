# Example staging configuration for the web platform.
#
# Same variables as production, pointing at the staging database and with its
# own secrets. On a host, set them in its dashboard; on your machine, copy this
# to `.env.staging` and run commands with NODE_ENV=staging.
# Never commit the real file.

# --- Application ---------------------------------------------------------
NODE_ENV=staging
# PORT=3000

# --- Database connection -------------------------------------------------
DATABASE_URL=

# --- External services ---------------------------------------------------
NINJA_API_KEY=

# --- Authentication ------------------------------------------------------
# Its own secret, at least 32 characters.
JWT_SECRET=
JWT_EXPIRES_IN=1h

# --- Audit ---------------------------------------------------------------
APP_TIMEZONE=Australia/Brisbane

# --- Seed (prisma/seed.js only) ------------------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
