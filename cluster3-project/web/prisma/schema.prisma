// Prisma schema for the web platform.
//
// Declares the PostgreSQL data source and the client generator. Prisma 7 no
// longer accepts the connection URL here: the CLI reads it from prisma.config.js
// and the runtime client receives a pg driver adapter (see src/lib/prisma.js),
// both sourced from the DATABASE_URL environment variable. No domain models
// exist yet; the first model arrives with the product catalogue slice.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===========================================================
// REFERENCE TABLES
// ===========================================================
model template {
  id          Int     @id @default(autoincrement())
  name        String
  code        String
  subject     String
  description String?
  html        String

  created    Json?
  updated    Json?
  statusName String    @default("ACTIVE")
  status     Int       @default(1)
  unixTime   Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("template")
}

model document_type {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  code        String  @unique
  description String?
  users       user[]

  created    Json?
  updated    Json?
  statusName String    @default("ACTIVE")
  status     Int       @default(1)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("documenType")
}


model role {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  code        String  @unique
  description String?
  users       user[]

  created    Json?
  updated    Json?
  statusName String    @default("ACTIVE")
  status     Int       @default(1)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("role")
}

model gender {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  code        String  @unique
  description String?
  users       user[]

  created    Json?
  updated    Json?
  statusName String    @default("ACTIVE")
  status     Int       @default(1)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("gender")
}

// ===========================================================
// USER TABLES
// ===========================================================
model user {
  id             Int       @id @default(autoincrement())
  roleId         Int
  genderId       Int
  documentTypeId Int
  name           String
  lastName       String
  email          String    @unique
  password       String // hashed automatically by middleware
  document       String?   @unique
  phone          String?
  address        String?
  emailVerified  Boolean   @default(false)

  session    DateTime?
  created    Json?
  updated    Json?
  statusName String?   @default("PENDING")
  status     Int       @default(-2)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  role         role          @relation(fields: [roleId], references: [id])
  gender       gender        @relation(fields: [genderId], references: [id])
  documentType document_type @relation(fields: [documentTypeId], references: [id])

  //auditLogs    audit_log[]
  purchases    purchase[]
  

  @@index([email], name: "idx_user_email")
  @@map("user")
}

// ===========================================================
// SHOP TABLES
// ===========================================================

model category {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  code        String  @unique
  img         String?  
  description String?
  products    product[]

  created    Json?
  updated    Json?
  statusName String    @default("ACTIVE")
  status     Int       @default(1)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("category")
}

model product {
  id          Int     @id @default(autoincrement())
  categoryId  Int
  name        String  @unique
  code        String  @unique  
  stock       Int     @default(0)
  price       Float   @default(0)
  img         String[] 
  description String?

  created    Json?
  updated    Json?
  statusName String    @default("ACTIVE")
  status     Int       @default(1)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  category   category  @relation(fields: [categoryId], references: [id])

  purchase_products purchase_products[]

  @@map("product")
}

// ===========================================================
// PURCHASE
// ===========================================================
// paymentStatus = PENDING, SUCCESS, FAILED, REJECTED
model purchase {
  id     Int @id @default(autoincrement())
  userId Int

  reference      String?

  totalAmount    Decimal
  taxes          Decimal @default(0)
  discountAmount Decimal @default(0)
  finalAmount    Decimal

  paymentStatus  String
  invoice        String?
  paymentDate    DateTime?
  data           Json?
 
  status         Int       @default(1)
  statusName     String    @default("ACTIVE")
  created        Json?
  updated        Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt


  user user @relation(fields: [userId], references: [id])
  
  products        purchase_products[]
 
  @@index([status, userId])
  @@map("purchase")
}

model purchase_products {
  id         Int     @id @default(autoincrement())
  purchaseId Int
  productId  Int
  amount     Decimal

  status     Int       @default(1)
  statusName String    @default("ACTIVE")
  created    Json?
  updated    Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  purchase purchase @relation(fields: [purchaseId], references: [id])
  product  product  @relation(fields: [productId], references: [id])

  @@map("purchaseProduct")
}