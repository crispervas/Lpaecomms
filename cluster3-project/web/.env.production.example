# Example production configuration for the web platform.
#
# Two uses:
# - On the host (Render), set these same variables in its dashboard; no .env
#   file is deployed there, and loadEnv reads none.
# - On your machine, copy this to `.env.production` to run Prisma or the seed
#   against the production database:
#     NODE_ENV=production pnpm db:migrate
#     NODE_ENV=production pnpm db:seed
#   Use the database's *external* URL here; the host uses the internal one.
# Never commit the real file: it holds production secrets.

# --- Application ---------------------------------------------------------
NODE_ENV=production
# The host sets PORT itself; only needed to run the server locally.
# PORT=3000

# --- Database connection -------------------------------------------------
# The managed PostgreSQL's connection string, e.g. from Render, Neon or Supabase.
DATABASE_URL=

# --- External services ---------------------------------------------------
# Optional: without it only GET /api/v1/convert answers 503.
NINJA_API_KEY=

# --- Authentication ------------------------------------------------------
# Its own secret, never the development one. At least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# --- Audit ---------------------------------------------------------------
APP_TIMEZONE=Australia/Brisbane

# --- Seed (prisma/seed.js only) ------------------------------------------
# The production administrator. Choose a strong password.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
