{
  "name": "lpaecomms-web",
  "version": "0.1.0",
  "description": "Server-rendered e-commerce store and REST API for Lpaecomms",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "test": "node --test",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build:css": "lessc styles/less/main.less src/public/css/main.css --clean-css",
    "dev:css": "less-watch-compiler styles/less src/public/css main.less"
  },
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^13.0.0",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "less": "^4.9.0",
    "less-plugin-clean-css": "^1.6.0",
    "less-watch-compiler": "^1.19.9",
    "prisma": "^7.9.0",
    "supertest": "^7.2.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  }
}
