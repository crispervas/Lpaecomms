{
  "name": "lpaecomms-web",
  "version": "0.1.0",
  "description": "Server-rendered e-commerce store and REST API for Lpaecomms",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "test": "node --test",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build:css": "tailwindcss -i ./styles/tailwind.css -o ./src/public/css/tailwind.css --minify",
    "dev:css": "tailwindcss -i ./styles/tailwind.css -o ./src/public/css/tailwind.css --watch"
  },
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "prisma": "^7.9.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.19"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  }
}
