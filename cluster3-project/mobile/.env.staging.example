# Example staging configuration for the mobile platform.
#
# Copy this file to `.env.staging`. `pnpm build:staging` runs Vite in staging
# mode, which reads it over `.env`. Never commit the real file.
#
# Vite only exposes variables prefixed VITE_ to import.meta.env, and bakes
# them into the bundle: never put a secret here.

# --- REST API ------------------------------------------------------------
# The staging web service, including the /api/v1 prefix.
VITE_API_BASE_URL=
